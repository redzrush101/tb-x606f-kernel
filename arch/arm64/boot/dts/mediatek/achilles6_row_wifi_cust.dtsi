&msdc1_ins {
	interrupt-parent = <&pio>;
	interrupts = <0x01 0x01 0x01 0x00>;
	status = "okay";
};

&accdet {
	interrupt-parent = <&pio>;
	interrupts = <0x09 0x08 0x09 0x00>;
	deb-gpios = <&pio 0x09 0x00>;
	debounce = <0x3e800>;
	status = "okay";
};

&touch {
	interrupt-parent = <&pio>;
	interrupts = <0x0a 0x08 0x0a 0x00>;
	status = "okay";
};

&otg_iddig {
	interrupt-parent = <&pio>;
	interrupts = <0x29 0x02 0x29 0x00>;
	status = "okay";
};

&dsi_te {
	interrupt-parent = <&pio>;
	interrupts = <0x2c 0x01 0x2c 0x01>;
	status = "okay";
};

&main_pmic {
	interrupt-parent = <&pio>;
	interrupts = <0x90 0x04 0x90 0x01>;
	status = "okay";
};

&md1_sim1_hot_plug_eint {
	compatible = "mediatek,md1_sim1_hot_plug_eint-eint";
	interrupts = <0x00 0x08>;
	debounce = <0x00 0x2710>;
	dedicated = <0x00 0x00>;
	src_pin = <0x00 0x01>;
	sockettype = <0x00 0x00>;
	status = "okay";
};

&md1_sim2_hot_plug_eint {
	compatible = "mediatek,md1_sim2_hot_plug_eint-eint";
	interrupts = <0x01 0x08>;
	debounce = <0x01 0x2710>;
	dedicated = <0x01 0x00>;
	src_pin = <0x01 0x02>;
	sockettype = <0x01 0x00>;
	status = "okay";
};

&mt_pmic_vcama_ldo_reg {
	regulator-name = "vcama";
	regulator-default-on = <0x01>;
	status = "okay";
};

&mt_pmic_vsim1_ldo_reg {
	regulator-name = "vsim1";
	regulator-default-on = <0x01>;
	status = "okay";
};

&mt_pmic_vsim2_ldo_reg {
	regulator-name = "vsim2";
	regulator-default-on = <0x01>;
	status = "okay";
};

&mt_pmic_vcamd_ldo_reg {
	regulator-name = "vcamd";
	regulator-default-on = <0x01>;
	status = "okay";
};

&mt_pmic_vcamio_ldo_reg {
	regulator-name = "vcamio";
	regulator-default-on = <0x01>;
	status = "okay";
};

&mt_pmic_vldo28_ldo_reg {
	regulator-name = "vldo28";
	regulator-default-on = <0x01>;
	status = "okay";
};

&kd_camera_hw1 {
	vcama-supply = <&mt_pmic_vcama_ldo_reg>;
	vcama_sub-supply = <&mt_pmic_vcama_ldo_reg>;
	vcamd_main2-supply = <&mt_pmic_vcamd_ldo_reg>;
	vcamd_sub-supply = <&mt_pmic_vcamd_ldo_reg>;
	vcamio-supply = <&mt_pmic_vcamio_ldo_reg>;
	vcamio_sub-supply = <&mt_pmic_vcamio_ldo_reg>;
	vcamio_main2-supply = <&mt_pmic_vcamio_ldo_reg>;
	vcamaf-supply = <&mt_pmic_vldo28_ldo_reg>;
	status = "okay";
};

&touch {
	status = "okay";
};

&keypad {
	mediatek,kpd-key-debounce = <0x400>;
	mediatek,kpd-sw-pwrkey = <0x74>;
	mediatek,kpd-hw-pwrkey = <0x08>;
	mediatek,kpd-use-extend-type = <0x00>;
	mediatek,kpd-hw-map-num = <0x48>;
	mediatek,kpd-hw-init-map = <
		0x73 0x72 0x00 0x00 0x00 0x00 0x00 0x00
		0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
		0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
		0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
		0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
		0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
		0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
		0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
		0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
	>;
	mediatek,kpd-pwrkey-eint-gpio = <0x00>;
	mediatek,kpd-pwkey-gpio-din = <0x00>;
	mediatek,kpd-hw-dl-key2 = <0x08>;
	mediatek,kpd-hw-recovery-key = <0x00>;
	mediatek,kpd-hw-factory-key = <0x01>;
	status = "okay";
};

&pio {

	camdefault: camdefault {
	};

	camera_pins_cam0_mclk_on: camera_pins_cam0_mclk_on {

		pins_cmd_dat {
			pinmux = <0x6301>;
		};
	};

	camera_pins_cam0_mclk_off: camera_pins_cam0_mclk_off {

		pins_cmd_dat {
			pinmux = <0x6300>;
		};
	};

	camera_pins_cam1_mclk_on: camera_pins_cam1_mclk_on {

		pins_cmd_dat {
			pinmux = <0x6401>;
		};
	};

	camera_pins_cam1_mclk_off: camera_pins_cam1_mclk_off {

		pins_cmd_dat {
			pinmux = <0x6400>;
		};
	};

	camera_pins_cam2_mclk_on: camera_pins_cam2_mclk_on {

		pins_cmd_dat {
			pinmux = <0x6c01>;
		};
	};

	camera_pins_cam2_mclk_off: camera_pins_cam2_mclk_off {

		pins_cmd_dat {
			pinmux = <0x6c00>;
		};
	};

	cam0: cam0@0 {

		pins_cmd_dat {
			pinmux = <0x6500>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	cam0_2d: cam0@1 {

		pins_cmd_dat {
			pinmux = <0x6500>;
			slew-rate = <0x01>;
			output-high;
		};
	};

	cam0_2e: cam0@2 {

		pins_cmd_dat {
			pinmux = <0x6100>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	cam0_2f: cam0@3 {

		pins_cmd_dat {
			pinmux = <0x6100>;
			slew-rate = <0x01>;
			output-high;
		};
	};

	cam1: cam1@0 {

		pins_cmd_dat {
			pinmux = <0x6600>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	cam1_31: cam1@1 {

		pins_cmd_dat {
			pinmux = <0x6600>;
			slew-rate = <0x01>;
			output-high;
		};
	};

	cam1_32: cam1@2 {

		pins_cmd_dat {
			pinmux = <0x6200>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	cam1_33: cam1@3 {

		pins_cmd_dat {
			pinmux = <0x6200>;
			slew-rate = <0x01>;
			output-high;
		};
	};

	cam2: cam2@0 {

		pins_cmd_dat {
			pinmux = <0x5700>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	cam2_35: cam2@1 {

		pins_cmd_dat {
			pinmux = <0x5700>;
			slew-rate = <0x01>;
			output-high;
		};
	};

	cam2_36: cam2@2 {

		pins_cmd_dat {
			pinmux = <0xa000>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	cam2_37: cam2@3 {

		pins_cmd_dat {
			pinmux = <0xa000>;
			slew-rate = <0x01>;
			output-high;
		};
	};

	cam0_39: cam0@vcamd0 {

		pins_cmd_dat {
			pinmux = <0x5800>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	cam0_38: cam0@vcamd1 {

		pins_cmd_dat {
			pinmux = <0x5800>;
			slew-rate = <0x01>;
			output-high;
		};
	};

	cam1_3b: cam1@vcamd0 {

		pins_cmd_dat {
			pinmux = <0xaa00>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	cam1_3a: cam1@vcamd1 {

		pins_cmd_dat {
			pinmux = <0xaa00>;
			slew-rate = <0x01>;
			output-high;
		};
	};

	cam1_3d: cam1@vcama0 {

		pins_cmd_dat {
			pinmux = <0xa900>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	cam1_3c: cam1@vcama1 {

		pins_cmd_dat {
			pinmux = <0xa900>;
			slew-rate = <0x01>;
			output-high;
		};
	};

	cam2_3f: cam2@vcama0 {

		pins_cmd_dat {
			pinmux = <0x9f00>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	cam2_3e: cam2@vcama1 {

		pins_cmd_dat {
			pinmux = <0x9f00>;
			slew-rate = <0x01>;
			output-high;
		};
	};
};

&kd_camera_hw1 {
	pinctrl-names = "default\0cam0_rst0\0cam0_rst1\0cam0_pnd0\0cam0_pnd1\0cam1_rst0\0cam1_rst1\0cam1_pnd0\0cam1_pnd1\0cam2_rst0\0cam2_rst1\0cam2_pnd0\0cam2_pnd1\0cam0_vcamd_on\0cam0_vcamd_off\0cam1_vcamd_on\0cam1_vcamd_off\0cam1_vcama_on\0cam1_vcama_off\0cam2_vcama_on\0cam2_vcama_off\0cam0_mclk_on\0cam0_mclk_off\0cam1_mclk_on\0cam1_mclk_off\0cam2_mclk_on\0cam2_mclk_off";
	pinctrl-0 = <&camdefault>;
	pinctrl-1 = <&cam0>;
	pinctrl-2 = <&cam0_2d>;
	pinctrl-3 = <&cam0_2e>;
	pinctrl-4 = <&cam0_2f>;
	pinctrl-5 = <&cam1>;
	pinctrl-6 = <&cam1_31>;
	pinctrl-7 = <&cam1_32>;
	pinctrl-8 = <&cam1_33>;
	pinctrl-9 = <&cam2>;
	pinctrl-10 = <&cam2_35>;
	pinctrl-11 = <&cam2_36>;
	pinctrl-12 = <&cam2_37>;
	pinctrl-13 = <&cam0_38>;
	pinctrl-14 = <&cam0_39>;
	pinctrl-15 = <&cam1_3a>;
	pinctrl-16 = <&cam1_3b>;
	pinctrl-17 = <&cam1_3c>;
	pinctrl-18 = <&cam1_3d>;
	pinctrl-19 = <&cam2_3e>;
	pinctrl-20 = <&cam2_3f>;
	pinctrl-21 = <&camera_pins_cam0_mclk_on>;
	pinctrl-22 = <&camera_pins_cam0_mclk_off>;
	pinctrl-23 = <&camera_pins_cam1_mclk_on>;
	pinctrl-24 = <&camera_pins_cam1_mclk_off>;
	pinctrl-25 = <&camera_pins_cam2_mclk_on>;
	pinctrl-26 = <&camera_pins_cam2_mclk_off>;
	cam0_vcama-supply = <&mt_pmic_vcama_ldo_reg>;
	cam0_vcamd-supply = <&mt_pmic_vcamd_ldo_reg>;
	cam0_vcamio-supply = <&mt_pmic_vcamio_ldo_reg>;
	cam1_vcama-supply = <&mt_pmic_vcama_ldo_reg>;
	cam1_vcamd-supply = <&mt_pmic_vcamd_ldo_reg>;
	cam1_vcamio-supply = <&mt_pmic_vcamio_ldo_reg>;
	cam0_enable_sensor = "s5k4h7yxqtech1_mipi_raw s5k4h7yx_mipi_raw ov13b10_mipi_raw s5k4h7yxqtech_mipi_raw ov13b10qtech_mipi_raw";
	cam1_enable_sensor = "gc5035_mipi_raw s5k4h7yxfront_mipi_raw gc5035kingcome_mipi_raw s5k4h7yxlcetron_mipi_raw ov5675_mipi_raw";
	status = "okay";
};

&otg_iddig {
	status = "okay";
	interrupt-parent = <&pio>;
	interrupts = <0x29 0x08 0x29 0x00>;
	usb,vbus_gpio = <&pio 0xa9 0x00>;
	usb,vbus_gpio_num = <0xa9>;
};

&msdc1 {
	cd_level = [01];
};
