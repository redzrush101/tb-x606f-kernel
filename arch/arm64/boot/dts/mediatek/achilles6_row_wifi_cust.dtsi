// SPDX-License-Identifier: GPL-2.0
/*
 * TB-X606F DrvGen output (GPIO, EINT, I2C, PMIC, KPD, camera pins), taken
 * from the stock Android 10 S301068 overlay. The 4.9 source drop's .dws is
 * older than the shipped hardware description, so it is not used.
 */

&auxadc {

	adc_channel@ {
		compatible = "mediatek,adc_channel";
		mediatek,temperature0 = <0x00>;
		mediatek,temperature1 = <0x01>;
		mediatek,adc_fdd_rf_params_dynamic_custom_ch = <0x02>;
		status = "okay";
	};
};

&pmic_clock_buffer_ctrl {
	mediatek,clkbuf-quantity = <0x07>;
	mediatek,clkbuf-config = <0x02 0x01 0x01 0x02 0x00 0x00 0x00>;
	mediatek,clkbuf-driving-current = <0x01 0x01 0x01 0x01 0x01 0x01 0x01>;
	status = "okay";
};

&i2c0 {
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	clock-frequency = <0x61a80>;
	mediatek,use-push-pull;
};

&i2c1 {
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	clock-frequency = <0x61a80>;
	mediatek,use-open-drain;
};

&i2c2 {
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	clock-frequency = <0x61a80>;
	mediatek,use-open-drain;

	camera_main: camera_main@1a {
		compatible = "mediatek,camera_main";
		reg = <0x1a>;
		status = "okay";
	};

	camera_main_eeprom: camera_main_eeprom@50 {
		compatible = "mediatek,camera_main_eeprom";
		reg = <0x50>;
		status = "okay";
	};

	camera_main_af: camera_main_af@0c {
		compatible = "mediatek,camera_main_af";
		reg = <0x0c>;
		status = "okay";
	};

	ccu_sensor_i2c_2_hw: ccu_sensor_i2c_2_hw@10 {
		compatible = "mediatek,ccu_sensor_i2c_2_hw";
		reg = <0x10>;
		status = "okay";
	};
};

&i2c3 {
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	clock-frequency = <0x61a80>;
	mediatek,use-open-drain;

	capsensor: capsensor@28 {
		compatible = "mediatek,capsensor";
		reg = <0x28>;
		status = "okay";
	};

	speaker_amp: speaker_amp@34 {
		compatible = "mediatek,speaker_amp";
		reg = <0x34>;
		status = "okay";
	};

	slave_charger: slave_charger@4b {
		compatible = "mediatek,slave_charger";
		reg = <0x4b>;
		status = "okay";
	};

	nfc: nfc@08 {
		compatible = "mediatek,nfc";
		reg = <0x08>;
		status = "okay";
	};

	ext_buck_lp4: ext_buck_lp4@57 {
		compatible = "mediatek,ext_buck_lp4";
		reg = <0x57>;
		status = "okay";
	};

	ext_buck_lp4x: ext_buck_lp4x@50 {
		compatible = "mediatek,ext_buck_lp4x";
		reg = <0x50>;
		status = "okay";
	};
};

&i2c4 {
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	clock-frequency = <0x61a80>;
	mediatek,use-open-drain;

	camera_sub: camera_sub@2e {
		compatible = "mediatek,camera_sub";
		reg = <0x2e>;
		status = "okay";
	};

	camera_sub_eeprom: camera_sub_eeprom@52 {
		compatible = "mediatek,camera_sub_eeprom";
		reg = <0x52>;
		status = "okay";
	};

	ccu_sensor_i2c_4_hw: ccu_sensor_i2c_4_hw@11 {
		compatible = "mediatek,ccu_sensor_i2c_4_hw";
		reg = <0x11>;
		status = "okay";
	};
};

&i2c5 {
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	clock-frequency = <0x61a80>;
	mediatek,use-open-drain;

	subpmic_pmu: subpmic_pmu@34 {
		compatible = "mediatek,subpmic_pmu";
		reg = <0x34>;
		status = "okay";
	};

	usb_type_c: usb_type_c@4e {
		compatible = "mediatek,usb_type_c";
		reg = <0x4e>;
		status = "okay";
	};

	i2c_lcd_bias: i2c_lcd_bias@3e {
		compatible = "mediatek,i2c_lcd_bias";
		reg = <0x3e>;
		status = "okay";
	};
};

&i2c6 {
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	clock-frequency = <0x61a80>;
	mediatek,use-open-drain;

	camera_main_two: camera_main_two@2d {
		compatible = "mediatek,camera_main_two";
		reg = <0x2d>;
		status = "okay";
	};

	camera_main_two_eeprom: camera_main_two_eeprom@50 {
		compatible = "mediatek,camera_main_two_eeprom";
		reg = <0x50>;
		status = "okay";
	};

	camera_main_two_af: camera_main_two_af@0c {
		compatible = "mediatek,camera_main_two_af";
		reg = <0x0c>;
		status = "okay";
	};
};

&i2c7 {
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	clock-frequency = <0x61a80>;
	mediatek,use-open-drain;
};

&i2c8 {
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	clock-frequency = <0x61a80>;
	mediatek,use-open-drain;
};

&i2c9 {
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	clock-frequency = <0x61a80>;
	mediatek,use-open-drain;
};

&gpio_usage_mapping {
	GPIO_SIM2_SIO = <&pio 0x23 0x00>;
	GPIO_SIM2_SRST = <&pio 0x24 0x00>;
	GPIO_SIM2_SCLK = <&pio 0x25 0x00>;
	GPIO_SIM1_SCLK = <&pio 0x26 0x00>;
	GPIO_SIM1_SRST = <&pio 0x27 0x00>;
	GPIO_SIM1_SIO = <&pio 0x28 0x00>;
	GPIO_SIM2_HOT_PLUG = <&pio 0x2e 0x00>;
	GPIO_SIM1_HOT_PLUG = <&pio 0x2f 0x00>;
};

