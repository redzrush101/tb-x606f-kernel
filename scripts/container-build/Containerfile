FROM docker.io/library/debian:bullseye-slim
# Bullseye provides the LLVM 11 toolchain expected by this vendor kernel.
# Its repositories moved to the Debian archive after the LTS period.
RUN printf '%s\n' \
    'deb http://archive.debian.org/debian bullseye main' \
    'deb http://archive.debian.org/debian-security bullseye-security main' \
    > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends \
    bc bison build-essential ca-certificates clang-11 cpio device-tree-compiler \
    file flex gcc-aarch64-linux-gnu gcc-arm-linux-gnueabi git \
    libelf-dev libssl-dev lld-11 llvm-11 python3 xz-utils \
    && rm -rf /var/lib/apt/lists/*
ENV PATH=/usr/lib/llvm-11/bin:$PATH
WORKDIR /src
